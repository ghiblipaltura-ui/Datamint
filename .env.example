# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# PAYOUT_WEBHOOK_URL: HTTPS backend endpoint (e.g. Firebase Cloud Function / RazorpayX / Cashfree / PayPal server)
# that verifies the Firebase Auth ID token and executes real money transfers.
# Set this securely via the Secrets panel in AI Studio.
PAYOUT_WEBHOOK_URL=UNCONFIGURED_PAYOUT_WEBHOOK_URL

# BANDWIDTH_RELAY_URL: Optional HTTPS bandwidth buyer relay endpoint that accepts
# authenticated chunk transfers to actively sustain up to 100 MB/min (1.67 MB/s / 13.98 Mbps).
# Set this securely via the Secrets panel in AI Studio.
BANDWIDTH_RELAY_URL=UNCONFIGURED_BANDWIDTH_RELAY_URL
